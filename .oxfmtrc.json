{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "quoteProps": "consistent",
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": ["dist/**", ".next/**", "pnpm-lock.yaml", "CHANGELOG.md", "async-react/**"],
  "overrides": [
    {
      "files": [".changeset/*.md"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": [
        "website/src/examples/**/*.js",
        "website/src/examples/**/*.jsx",
        "website/src/examples/**/*.ts",
        "website/src/examples/**/*.tsx"
      ],
      "options": {
        "printWidth": 50,
        "tabWidth": 2,
        "singleQuote": true,
        "quoteProps": "consistent",
        "bracketSpacing": false
      }
    }
  ]
}
