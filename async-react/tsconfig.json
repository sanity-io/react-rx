{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/vite-react/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["react/canary", "vite/client", "node"]
  },
  "include": ["src/**/*", "vite.config.ts", "server.ts"]
}
