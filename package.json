    "knip": "^6.31.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.17.0"
