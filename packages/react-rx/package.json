    "react-dom": "^19.2.1",
    "react-test-renderer": "^19.2.1",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.3 || >=19.0.0-0",
    "rxjs": "^7"
  }
