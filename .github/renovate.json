{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sanity-io/renovate-config", ":reviewer(team:ecosystem)"],
  "ignorePresets": ["github>sanity-io/renovate-config:group-non-major"],
  "packageRules": [
    {
      "matchFileNames": ["website/package.json"],
      "groupName": "website",
      "semanticCommitType": "chore"
    },
    {
      "matchPackageNames": ["react-rx-old"],
      "allowedVersions": "<=2.x"
    },
    {
      "matchPackageNames": ["observable-callback", "use-effect-event"],
      "rangeStrategy": "bump",
      "semanticCommitType": "fix"
    }
  ]
}
